# Copie para .env e preencha. O .env NUNCA vai para o Git.
POSTGRES_PASSWORD=troque-esta-senha
GRAFANA_PASSWORD=troque-esta-senha
# Chave que robô (Maker Lab), visão e RPA mandam no header X-API-Key dos POSTs
INGEST_API_KEY=
# URL do serviço de GenAI (ex.: http://assistente:8001/perguntar). Vazio = fallback de regras
ASSISTENTE_URL=
# true = popula dados simulados e move os ônibus de demonstração
DEMO=true
PORTA_PUBLICA=80
